# ===== ROYAL ADVENTURE — konfigurasi frontend =====
# Salin menjadi .env lalu isi. Hanya kunci PUBLIK yang boleh ada di sini.
# JANGAN PERNAH menaruh SUPABASE_SERVICE_ROLE_KEY di frontend.

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-public-key

# Alamat backend FastAPI.
# Laptop: http://localhost:8000
# Emulator Android: http://10.0.2.2:8000 ; HP fisik: http://<IP-laptop-di-WiFi>:8000 atau URL server publik (https)
VITE_API_URL=http://localhost:8000
