# ===== ROYAL ADVENTURE — konfigurasi backend (FastAPI) =====
# Salin menjadi .env lalu isi. JANGAN commit file .env.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=isi-anon-public-key
# RAHASIA — hanya untuk server, jangan pernah ditaruh di frontend
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key

# Rahasia untuk menurunkan password akun siswa dari kode siswa (min. 32 karakter acak).
# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
# Jika diganti, siswa lama tetap bisa login (password otomatis disetel ulang saat login).
STUDENT_PASSWORD_SECRET=ganti-dengan-64-karakter-hex-acak
# Domain email internal akun siswa (tidak pernah dikirimi email)
STUDENT_EMAIL_DOMAIN=students.royal-adventure.app

# Kunci untuk halaman pengelolaan siswa (/admin) — bagikan hanya ke guru
ADMIN_API_KEY=ganti-dengan-kunci-admin-acak

# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost,https://localhost

# Final Quest — 0 = pakai nilai di tabel quizzes (question_count, time_limit_seconds)
FINAL_QUESTION_COUNT=0
FINAL_TIME_LIMIT_SECONDS=0
